# =============================================================================
# Fathers.com — environment template
# Copy to .env.local for development. Never commit real secrets.
# NEXT_PUBLIC_* is sent to the browser. Everything else is server-only.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Use the production project URL/keys in Vercel Production.
# Never paste a service-role key into a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Prefer the publishable key. Legacy anon key is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public app URL (required for auth redirects and email links) ------------
# Local: http://localhost:3000
# Production: https://your-production-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional aliases. APP_URL wins for server-rendered email links.
# APP_URL=https://your-production-domain
# NEXT_PUBLIC_APP_URL=https://your-production-domain

# --- Supabase service role (server-only) -------------------------------------
# Required for /api/cron/reminders. Never import it into Client Components.
# SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube Data API (optional, server-only) --------------------------------
# Used to fill session duration_seconds on save and for catalog backfill.
# When unset, admins enter runtime by hand. Sessions with a null duration are
# flagged as "Runtime missing" on /admin/trainings.
# YOUTUBE_API_KEY=

# --- Email (optional — no-op when unset so local/pilot still works) ----------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Fathers.com <noreply@mail.fathers.com>

# --- Reminders (optional — email fallback still works without push) ----------
# CRON_SECRET=long-random-string
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/reminders
# every 15 minutes. The dispatcher also needs SUPABASE_SERVICE_ROLE_KEY.
# npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@fathers.com

# --- Sentry (optional — no-op when DSN unset) --------------------------------
# The DSN is designed to be public. Use NEXT_PUBLIC_SENTRY_DSN for the browser.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Source-map upload (CI / Vercel only; never expose to the client):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
