{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Fathers live local sync",
      "type": "shell",
      "command": "node scripts/dev-live.mjs --watch-only",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "fathers-live",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "watching|already serving|updated|skipped"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      }
    }
  ]
}
